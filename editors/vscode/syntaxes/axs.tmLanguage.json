{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AXS",
  "scopeName": "source.axs",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#blockHeaders"
    },
    {
      "include": "#assignments"
    },
    {
      "include": "#arrayItems"
    },
    {
      "include": "#arrayMarkers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.axs",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "blockHeaders": {
      "patterns": [
        {
          "match": "^(\\s*)(-\\s+)?([A-Za-z_][A-Za-z0-9_-]*)(\\s*:)\\s*$",
          "captures": {
            "2": {
              "name": "punctuation.definition.list.axs"
            },
            "3": {
              "name": "entity.name.tag.axs"
            },
            "4": {
              "name": "punctuation.separator.key-value.axs"
            }
          }
        }
      ]
    },
    "assignments": {
      "patterns": [
        {
          "match": "^(\\s*)(-\\s+)?([A-Za-z_][A-Za-z0-9_-]*)(\\s*=)\\s*(.*?)\\s*$",
          "captures": {
            "2": {
              "name": "punctuation.definition.list.axs"
            },
            "3": {
              "name": "variable.other.property.axs"
            },
            "4": {
              "name": "keyword.operator.assignment.axs"
            },
            "5": {
              "patterns": [
                {
                  "include": "#value"
                }
              ]
            }
          }
        }
      ]
    },
    "arrayMarkers": {
      "patterns": [
        {
          "name": "punctuation.definition.list.axs",
          "match": "^\\s*-(?=\\s*$)"
        }
      ]
    },
    "arrayItems": {
      "patterns": [
        {
          "match": "^(\\s*)(-)\\s+(.*?)\\s*$",
          "captures": {
            "2": {
              "name": "punctuation.definition.list.axs"
            },
            "3": {
              "patterns": [
                {
                  "include": "#value"
                }
              ]
            }
          }
        }
      ]
    },
    "value": {
      "patterns": [
        {
          "name": "constant.language.axs",
          "match": "(?:true|false|null)$"
        },
        {
          "name": "constant.numeric.axs",
          "match": "-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {
          "name": "constant.language.empty-collection.axs",
          "match": "(?:\\[\\]|\\{\\})$"
        },
        {
          "name": "string.quoted.double.axs",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.axs"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.axs"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.axs",
              "match": "\\\\(?:[\"\\\\nrt0]|u\\{[0-9a-fA-F]+\\})"
            }
          ]
        },
        {
          "name": "string.unquoted.axs",
          "match": ".+$"
        }
      ]
    }
  }
}
