{
  "name": "axs-language",
  "displayName": "AXS Language",
  "description": "Syntax highlighting, live diagnostics, canonical formatting, and smart list editing for AXS files. No Rust or CLI installation required.",
  "version": "0.1.0",
  "publisher": "reaxios",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/olehvitriachenko/axs.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/olehvitriachenko/axs#readme",
  "bugs": {
    "url": "https://github.com/olehvitriachenko/axs/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "axs",
    "configuration",
    "config",
    "serialization",
    "data format",
    "formatter"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "axs",
        "aliases": [
          "AXS"
        ],
        "extensions": [
          ".axs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "axs",
        "scopeName": "source.axs",
        "path": "./syntaxes/axs.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "axs.continueList",
        "title": "AXS: Continue List"
      }
    ],
    "keybindings": [
      {
        "command": "axs.continueList",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == axs && !suggestWidgetVisible && !inSnippetMode"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "axs.continueList",
          "when": "false"
        }
      ]
    },
    "configurationDefaults": {
      "[axs]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    },
    "configuration": {
      "title": "AXS",
      "properties": {
        "axs.smartEnter.defaultCollection": {
          "type": "string",
          "enum": [
            "array",
            "object"
          ],
          "enumDescriptions": [
            "Insert an indented list marker (- ) for a new block.",
            "Insert indentation only for a new block."
          ],
          "default": "array",
          "scope": "resource",
          "description": "Collection style inserted by Enter after a new block header or bare dash. Existing child lines override this preference."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "node scripts/test.mjs",
    "test:host": "node scripts/smoke-test.mjs",
    "package": "vsce package --no-dependencies",
    "watch": "node scripts/build.mjs --watch"
  },
  "devDependencies": {
    "@axs-lang/core": "file:../../packages/axs",
    "@types/node": "~20.19.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "~4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0",
    "vscode-oniguruma": "~2.0.1",
    "vscode-textmate": "~9.3.2"
  }
}
