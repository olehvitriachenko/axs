{
  "$schema": "vscode://schemas/language-configuration",
  "comments": {
    "lineComment": {
      "comment": "#",
      "noIndent": false
    }
  },
  "brackets": [
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "surroundingPairs": [
    [
      "\"",
      "\""
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": {
      "pattern": "^\\s*(?:-\\s+)?(?:[A-Za-z_][A-Za-z0-9_.-]*|\"[^\"]*\")(?:\\[\\d*\\])?(?:\\{[^}]*\\})?\\s*:\\s*(?:\\|\\s*)?$"
    },
    "decreaseIndentPattern": {
      "pattern": "^\\s*$"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:-\\s+)?(?:[A-Za-z_][A-Za-z0-9_.-]*|\"[^\"]*\")(?:\\[\\d*\\])?(?:\\{[^}]*\\})?\\s*:\\s*(?:\\|\\s*)?$",
      "action": {
        "indent": "indent"
      }
    }
  ]
}
