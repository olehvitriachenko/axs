{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": false,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src"
  }
}
