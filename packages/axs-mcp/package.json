{
  "name": "@axs-lang/mcp",
  "version": "0.1.0",
  "description": "MCP proxy and helpers that return tool results as compact AXS instead of JSON, with optional server-side filtering",
  "keywords": ["axs", "mcp", "model-context-protocol", "llm", "tokens"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olehvitriachenko/axs.git",
    "directory": "packages/axs-mcp"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "axs-mcp": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@axs-lang/core": "file:../axs",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "typescript": "~5.9.3"
  }
}
